# EditorConfig — consistent formatting across editors
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{png,svg,jpg,ico,zip}]
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
